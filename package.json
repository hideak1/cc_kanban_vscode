{
  "name": "claude-kanban",
  "displayName": "Claude Kanban",
  "description": "A kanban board for your Claude Code sessions: organize them in columns, see live status, click a card to attach.",
  "version": "0.1.0",
  "publisher": "hideak1",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/hideak1/cc_kanban_vscode.git"
  },
  "homepage": "https://github.com/hideak1/cc_kanban_vscode#readme",
  "bugs": {
    "url": "https://github.com/hideak1/cc_kanban_vscode/issues"
  },
  "keywords": [
    "claude",
    "claude code",
    "kanban",
    "agents",
    "sessions",
    "ai"
  ],
  "galleryBanner": {
    "color": "#1e1f24",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "claudeKanban.open",
        "title": "Claude Kanban: Open Board"
      }
    ],
    "configuration": {
      "title": "Claude Kanban",
      "properties": {
        "claudeKanban.claudePath": {
          "type": "string",
          "default": "",
          "description": "Absolute path to the claude CLI. Leave empty to auto-detect."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "npm run build && node test/e2e/run.mjs",
    "test:real": "esbuild test/integration/realCli.ts --bundle --platform=node --format=esm --log-level=warning --outfile=.vscode-test/realCli.mjs && node .vscode-test/realCli.mjs",
    "package": "npm run build && vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/vscode": "^1.90.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
